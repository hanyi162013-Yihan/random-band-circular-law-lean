/-- If the random second moment is integrable, fiberwise Parseval becomes an
exact conditional-expectation identity.  The integrability hypothesis is
separate from the caller-facing terminal package because Bochner conditional
expectation is defined to be zero on non-integrable functions. -/
theorem packetTerminalRandomQ_condExp_parseval
    (mu : Measure Omega) [IsProbabilityMeasure mu]
    {W : Nat} (z : Complex)
    (X : IidSubgaussianFamily Omega mu (ThreeBlockVariable (Fin W)))
    (Q : Omega -> Matrix (PacketOuter (Fin W)) (PacketOuter (Fin W)) Complex)
    (hsecondMoment : Integrable
      (fun omega => norm (packetTerminalValue (Q omega) z X omega) ^ 2) mu)
    (mOutside : MeasurableSpace Omega)
    (hmOutside : mOutside <= mOmega)
    (hQ : @Measurable Omega
      (Matrix (PacketOuter (Fin W)) (PacketOuter (Fin W)) Complex)
      mOutside inferInstance Q)
    (h_indep : @Indep Omega mOutside
      (MeasurableSpace.comap
        (@packetFreshSample Omega (Fin W) mOmega inferInstance inferInstance
          mu X) inferInstance) mOmega mu) :
    mu[fun eta => norm (@packetTerminalValue Omega (Fin W) mOmega
          inferInstance inferInstance mu (Q eta) z X eta) ^ 2 |
        mOutside] =ᵐ[mu]
      fun omega => packetTerminalCoefficientNorm (Q omega) z ^ 2 := by
  letI : MeasurableSpace Omega := mOmega
  let fresh := packetFreshSample X
  let second := packetTerminalSecondMoment (w := Fin W) z
  have hfresh : Measurable fresh := measurable_packetFreshSample X
  have hQOutside : @Measurable Omega
      (Matrix (PacketOuter (Fin W)) (PacketOuter (Fin W)) Complex)
      mOutside inferInstance Q := hQ
  have hsecond : StronglyMeasurable second :=
    (measurable_packetTerminalSecondMoment (w := Fin W) z).stronglyMeasurable
  have heq := condExp_parameterized_ae_eq_integral_map_of_indepSigma
    mu mOutside hmOutside Q fresh hQOutside hfresh.aemeasurable h_indep
    second hsecond (by simpa [second, packetTerminalSecondMoment, fresh]
      using hsecondMoment)
  refine heq.trans (ae_of_all mu fun omega => ?_)
  change (∫ x, second (Q omega, x) ∂Measure.map fresh mu) = _
  rw [integral_map hfresh.aemeasurable]
  · simpa [second, packetTerminalSecondMoment, fresh] using
      (packetTerminal_parseval mu (Q omega) z X).symm
  · exact (hsecond.comp_measurable
      (measurable_const.prodMk measurable_id)).aestronglyMeasurable

