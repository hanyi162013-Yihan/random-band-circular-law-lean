    filter_upwards [heq] with omega homega
    have hfailureEq :
        (fun eta => failure (Q eta, fresh eta)) =
          fun eta =>
            (coordinatewiseBoundedEvent X M)ᶜ.indicator
              (fun _ => (1 : Real)) eta := by
      funext eta
      exact packetReverseFailureIndicator_packetFreshSample X M eta
    rw [← hfailureEq]
    rw [homega]
    rw [integral_map hfresh.aemeasurable]
    · have C := fixed (Q omega)
      have hmeasEvent : MeasurableSet (coordinatewiseBoundedEvent X M) := by
        exact measurableSet_coordinatewiseBoundedEvent X M
      have hintegral :
          (∫ eta, failure (Q omega, fresh eta) ∂mu) =
            mu.real (coordinatewiseBoundedEvent X M)ᶜ := by
        have hfun : (fun eta => failure (Q omega, fresh eta)) =
            (coordinatewiseBoundedEvent X M)ᶜ.indicator
