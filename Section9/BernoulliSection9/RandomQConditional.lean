        (measurable_const.prodMk measurable_id)).aestronglyMeasurable
  · intro omega
    rw [integral_map hfresh.aemeasurable]
    · simpa [fresh] using packetTerminal_parseval mu (Q omega) z X
    · exact ((measurable_packetTerminalSecondMoment
